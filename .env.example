PORT=3000
DATABASE_PATH=./data/app.db
# Em produção, DATABASE_URL ativa automaticamente o PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
BASE_PUBLIC_URL=http://localhost:3000
APP_SECRET=
ADMIN_PASSWORD=
# Acesso compartilhado e restrito à consulta de CPF para atendentes.
STAFF_PORTAL_USERNAME=
STAFF_PORTAL_PASSWORD=
ENCRYPTION_KEY=

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=

# Checkout hospedado e webhook Lastlink (substitui o Mercado Pago no fluxo novo)
LASTLINK_CHECKOUT_URL=
# Links individuais usados pela landing de planos. Se VIP não for definido,
# LASTLINK_CHECKOUT_URL é usado como fallback temporário.
LASTLINK_VIP_CHECKOUT_URL=
LASTLINK_CLUBE_CHECKOUT_URL=
# Use segredos diferentes por checkout. Eles são enviados pela Lastlink no webhook,
# nunca no navegador nem no repositório.
LASTLINK_VIP_WEBHOOK_SECRET=
LASTLINK_CLUBE_WEBHOOK_SECRET=
LASTLINK_VIP_AMOUNT_CENTS=9700
LASTLINK_CLUBE_AMOUNT_CENTS=49700
LASTLINK_WEBHOOK_SECRET=
LASTLINK_OFFER_ID=
LASTLINK_PRODUCT_ID=

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_FROM=

GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=openai/gpt-oss-20b
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
ELEVENLABS_API_KEY=

TELEGRAM_BOT_TOKEN=
WA_AUTH_FOLDER=./.wwebjs_auth
UPLOAD_DIR=./uploads/real-products

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FFMPEG_PATH=
ENABLE_LEGACY_WHATSAPP=false
ENABLE_LEGACY_SCRAPER=false
