{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/webhooks/lastlink",
      "destination": "/api/lastlink-webhook"
    },
    {
      "source": "/api/admin/overview",
      "destination": "/api/admin-overview"
    },
    {
      "source": "/api/staff/cpf-lookup",
      "destination": "/api/staff-cpf-lookup"
    },
    {
      "source": "/api/:path*",
      "destination": "https://garimpo-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/consulta",
      "destination": "/consulta.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
